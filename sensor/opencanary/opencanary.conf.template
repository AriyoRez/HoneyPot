# =============================================================================
# OpenCanary configuration TEMPLATE  (opencanary.conf.template)
# =============================================================================
# This is a TEMPLATE, not a working config. It contains PLACEHOLDER ports and
# FAKE banner values only — no real secrets, tokens, or credentials.
#
# HOW TO USE (on the Linux sensor VM, NOT committed):
#   1. Copy this file to `opencanary.conf` on the VM.
#   2. Replace every REPLACE_ME_* placeholder with real values for that host.
#   3. Adjust ports/banners to match the deception profile you want to present.
#   4. NEVER commit the filled-in `opencanary.conf` — it is gitignored.
#
# The body below is valid JSON (OpenCanary reads strict JSON). Explanatory notes
# live in "_comment_*" keys, which OpenCanary ignores. Strip the leading "#"
# comment block above before use if your tooling requires pure JSON.
#
# MVP decoy modules enabled here: ssh, http, mysql.
#
# REALISM / BELIEVABILITY (see docs/deception-profile.md):
#   - Decoys use STANDARD ports (22/80/3306) so they blend in with real internal
#     hosts. Non-standard ports (2222/8080) are a classic honeypot tell.
#   - Ports <1024 require privilege: run opencanaryd as root OR grant the Python
#     interpreter `cap_net_bind_service`.
#   - The host's REAL management sshd must NOT also sit on :22. Move it to a
#     management interface/port (dual-NIC decoy pattern) before enabling ssh on 22,
#     or front the decoy with a host-level redirect (22->2222). See deception-profile.
#   - Banners below are FAKE but INTERNALLY CONSISTENT with one OS persona
#     (Ubuntu 22.04 LTS / "jammy"). Mismatched versions (SSH vs MySQL vs OS) are a
#     tell — keep SSH/HTTP/MySQL versions consistent with the VM you actually run.
# =============================================================================
{
    "_comment_device": "Identify this decoy node in logs / the frontend. Use a non-identifying label.",
    "device.node_id": "REPLACE_ME_NODE_ID",

    "ip.ignorelist": [],
    "logtype.ignorelist": [],

    "_comment_ssh": "SSH decoy on the standard port. Version string matches the Ubuntu 22.04 persona; tune to the real VM. Needs privilege to bind :22 (see header).",
    "ssh.enabled": true,
    "ssh.port": 22,
    "ssh.version": "SSH-2.0-OpenSSH_8.9p1 Ubuntu-3ubuntu0.10",

    "_comment_http": "HTTP web-admin decoy on the standard port. Server header + skin should tell one consistent story (nginx on Ubuntu). Skin choice is itself fingerprintable.",
    "http.enabled": true,
    "http.port": 80,
    "http.banner": "Server: nginx/1.18.0 (Ubuntu)",
    "http.skin": "basicLogin",

    "_comment_mysql": "MySQL decoy on the standard port. Version banner consistent with the Ubuntu 22.04 persona's packaged MySQL.",
    "mysql.enabled": true,
    "mysql.port": 3306,
    "mysql.banner": "8.0.36-0ubuntu0.22.04.1",

    "_comment_logger": "Local file logging on the VM. The custom frontend (app/reader) reads these events directly for display.",
    "logger": {
        "class": "PyLogger",
        "kwargs": {
            "formatters": {
                "plain": { "format": "%(message)s" }
            },
            "handlers": {
                "file": {
                    "class": "logging.FileHandler",
                    "filename": "REPLACE_ME_LOG_PATH/opencanary.log"
                }
            }
        }
    }
}
